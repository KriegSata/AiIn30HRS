{
  "name": "harvestlink",
  "version": "0.1.0",
  "private": true,
  "description": "Traceable B2B marketplace for farmers, fishers, buyers and logistics partners",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:compiled": "npm run build:api && node scripts/dev.mjs --compiled",
    "dev:api": "node --env-file-if-exists=.env.local --import tsx apps/api/src/main.ts",
    "dev:web": "next dev apps/web --hostname 127.0.0.1 --port 3100",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "build:web": "next build apps/web",
    "build": "npm run build:api && npm run build:web",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "node --import tsx --test apps/api/test/*.test.ts db/*.test.ts",
    "test:compiled": "tsc -p tsconfig.test.json && node --test dist/tests/apps/api/test/*.test.js dist/tests/db/*.test.js",
    "test:coverage:compiled": "tsc -p tsconfig.test.json && c8 --include=dist/tests/apps/api/src/** --exclude=dist/tests/apps/api/src/main.js --exclude=dist/tests/apps/api/src/database.js --reporter=text --reporter=json-summary --reporter=html node --test dist/tests/apps/api/test/*.test.js",
    "test:coverage": "c8 --include=apps/api/src/** --exclude=apps/api/src/main.ts --exclude=apps/api/src/database.ts --reporter=text --reporter=json-summary --reporter=html node --import tsx --test apps/api/test/*.test.ts",
    "test:e2e": "playwright test",
    "check:contracts": "node scripts/check-contracts.mjs",
    "demo:credentials": "node scripts/demo-credentials.mjs",
    "test:native": "npm run build:api && node scripts/test-native-postgres.mjs",
    "test:spatial": "npm run build:api && node scripts/test-spatial.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-express": "12.3.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "bullmq": "6.7.0",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "lucide-react": "1.68.0",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite-postgis": "0.2.15",
    "@playwright/test": "1.64.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "c8": "12.0.0",
    "embedded-postgres": "18.6.0-beta.19",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "test-exclude": {
      "glob": "14.0.3",
      "minimatch": "11.0.4"
    }
  }
}
