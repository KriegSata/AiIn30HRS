{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harvestlink.example/contracts/events/1.0.0",
  "title": "HarvestLink event envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "schemaVersion", "aggregateId", "aggregateVersion", "occurredAt", "correlationId", "audienceOrgIds", "data"],
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "type": {"enum": ["listing.changed", "order.created", "order.status_changed", "shipment.updated", "temperature.excursion", "payment.updated", "verification.updated", "dispute.updated"]},
    "schemaVersion": {"const": "1.0.0"},
    "aggregateId": {"type": "string", "format": "uuid"},
    "aggregateVersion": {"type": "integer", "minimum": 1},
    "occurredAt": {"type": "string", "format": "date-time"},
    "correlationId": {"type": "string", "minLength": 1, "maxLength": 128},
    "audienceOrgIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
    "data": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "listing.changed"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/listing"}}}},
    {"if": {"properties": {"type": {"enum": ["order.created", "order.status_changed"]}}}, "then": {"properties": {"data": {"$ref": "#/$defs/order"}}}},
    {"if": {"properties": {"type": {"const": "shipment.updated"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/shipment"}}}},
    {"if": {"properties": {"type": {"const": "temperature.excursion"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/temperature"}}}},
    {"if": {"properties": {"type": {"const": "payment.updated"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/payment"}}}},
    {"if": {"properties": {"type": {"const": "verification.updated"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/verification"}}}},
    {"if": {"properties": {"type": {"const": "dispute.updated"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/dispute"}}}}
  ],
  "$defs": {
    "listing": {"type": "object", "additionalProperties": false, "required": ["listingId", "status"], "properties": {"listingId": {"type": "string", "format": "uuid"}, "status": {"enum": ["draft", "active", "paused", "sold_out", "recalled"]}}},
    "order": {"type": "object", "additionalProperties": false, "required": ["orderId", "status"], "properties": {"orderId": {"type": "string", "format": "uuid"}, "status": {"enum": ["pending_confirmation", "confirmed", "preparing", "ready_for_pickup", "in_transit", "delivered", "completed", "cancelled", "expired"]}}},
    "shipment": {"type": "object", "additionalProperties": false, "required": ["shipmentId", "orderId", "status"], "properties": {"shipmentId": {"type": "string", "format": "uuid"}, "orderId": {"type": "string", "format": "uuid"}, "status": {"enum": ["scheduled", "picked_up", "in_transit", "delivered", "exception"]}}},
    "temperature": {"type": "object", "additionalProperties": false, "required": ["shipmentId", "readingId", "temperatureC"], "properties": {"shipmentId": {"type": "string", "format": "uuid"}, "readingId": {"type": "string", "format": "uuid"}, "temperatureC": {"type": "number", "minimum": -80, "maximum": 60}}},
    "payment": {"type": "object", "additionalProperties": false, "required": ["orderId", "status"], "properties": {"orderId": {"type": "string", "format": "uuid"}, "status": {"enum": ["unpaid", "held", "released", "refunded", "disputed"]}}},
    "verification": {"type": "object", "additionalProperties": false, "required": ["organizationId", "status"], "properties": {"organizationId": {"type": "string", "format": "uuid"}, "status": {"enum": ["pending", "verified", "rejected", "suspended"]}}},
    "dispute": {"type": "object", "additionalProperties": false, "required": ["disputeId", "orderId", "status"], "properties": {"disputeId": {"type": "string", "format": "uuid"}, "orderId": {"type": "string", "format": "uuid"}, "status": {"enum": ["open", "under_review", "resolved_refund", "resolved_release"]}}}
  }
}
